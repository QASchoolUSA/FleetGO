# Site — use your live HTTPS URL in production (Merchant feed links, sitemap, Stripe, OG)
# Production: https://fleetgollc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Merchant Center scheduled feed — GET /api/feeds/google-merchant?key=…
GOOGLE_MERCHANT_FEED_SECRET=change-me-google-merchant-feed

# Sanity (provide real credentials when ready)
# Production catalog: 72peidqu (fleetgollc.com). Local sample-data is used only when unset/placeholder.
NEXT_PUBLIC_SANITY_PROJECT_ID=72peidqu
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_USE_CDN=true
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=change-me

# Shared with Convex — Bearer token for POST /api/inventory/sync
INVENTORY_SYNC_SECRET=change-me-inventory-sync

# Convex HTTP site URL (…convex.site) — notifies mobile when a web product is deleted
# CONVEX_SITE_URL=https://beaming-partridge-751.convex.site

# Auto-publish Sanity products from inventory sync (default true)
# AUTO_PUBLISH=false

# Stripe (test mode keys are fine for local)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
