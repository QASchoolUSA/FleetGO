# Site — use your live HTTPS URL in production so iMessage/Slack previews resolve og:image
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity (provide real credentials when ready)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_USE_CDN=true
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=change-me

# Shared with Convex — Bearer token for POST /api/inventory/sync
INVENTORY_SYNC_SECRET=change-me-inventory-sync

# Auto-publish Sanity products from inventory sync (default true)
# AUTO_PUBLISH=false

# Stripe (test mode keys are fine for local)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
